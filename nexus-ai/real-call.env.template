# ============================================================
# 真实 MaaS / OCR 调用验收 - 环境变量模板
# 用法：复制为 real-call.env（已被 .gitignore 忽略），填入真实值，
#       然后运行 ./verify-real-call.sh real-call.env
# 注意：真实凭据禁止写入仓库，只允许出现在本地 real-call.env 或系统环境变量中。
# ============================================================

# ---------- MaaS 大模型（文本抽取，P0）----------
# 区域域名，代码自动追加 /v1/chat/completions
NEXUS_AI_MAAS_BASE_URL=https://maas-api.cn-southwest-2.myhuaweicloud.com
# MaaS 控制台申请的 API Key
NEXUS_AI_MAAS_API_KEY=<填 MaaS API Key>
# 模型名，例如 qwen2.5-32b-instruct
NEXUS_AI_MAAS_MODEL=<填模型名>
NEXUS_AI_MAAS_TEMPERATURE=0.1

# ---------- OCR（图片识别，阶段一仅图片，PDF 待阶段二 OBS）----------
NEXUS_AI_OCR_IAM_ENDPOINT=https://iam.cn-north-4.myhuaweicloud.com
NEXUS_AI_OCR_ENDPOINT=https://ocr.cn-north-4.myhuaweicloud.com
NEXUS_AI_OCR_USERNAME=<填 IAM 用户名>
NEXUS_AI_OCR_PASSWORD=<填 IAM 密码>
NEXUS_AI_OCR_DOMAIN_NAME=<填账号名>
NEXUS_AI_OCR_PROJECT_ID=<填项目 ID>

# ---------- Demo ----------
# 真实联调时填 A 上传服务生成的 world_sources.id；演示可留默认 UUID
NEXUS_AI_DEMO_SOURCE_ID=00000000-0000-4000-8000-000000000001
