# NEXUS ECS 环境变量模板 —— 复制到 /etc/nexus/nexus.env 后填真实值
# 红线（docs/05 与 cloud-deployment-plan 第 10 节）：本文件权限 600，真实凭据不进仓库、不进日志

# ---- 基础 ----
SPRING_PROFILES_ACTIVE=prod
NEXUS_JWT_SECRET=change-me-32-bytes-random

# ---- RDS PostgreSQL ----
NEXUS_RDS_HOST=127.0.0.1
NEXUS_RDS_PORT=5432
NEXUS_RDS_DB=nexus
NEXUS_RDS_USER=nexus
NEXUS_RDS_PASSWORD=

# ---- Redis ----
NEXUS_REDIS_HOST=127.0.0.1
NEXUS_REDIS_PORT=6379
NEXUS_REDIS_PASSWORD=

# ---- OBS（专用 IAM 用户 AK/SK，最小权限）----
NEXUS_OBS_ENDPOINT=https://obs.cn-north-4.myhuaweicloud.com
NEXUS_OBS_BUCKET=nexus-demo
NEXUS_OBS_AK=
NEXUS_OBS_SK=

# ---- MaaS（模型名与路径以控制台「API调用」面板为准）----
NEXUS_AI_MAAS_BASE_URL=https://api.modelarts-maas.com
NEXUS_AI_MAAS_COMPLETION_PATH=/v2/chat/completions
NEXUS_AI_MAAS_API_KEY=
NEXUS_AI_MAAS_MODEL=

# ---- OCR + IAM（专用最小权限用户）----
NEXUS_AI_OCR_ENDPOINT=https://ocr.cn-north-4.myhuaweicloud.com
NEXUS_AI_OCR_IAM_ENDPOINT=https://iam.cn-north-4.myhuaweicloud.com
NEXUS_AI_OCR_USERNAME=
NEXUS_AI_OCR_PASSWORD=
NEXUS_AI_OCR_DOMAIN_NAME=
NEXUS_AI_OCR_PROJECT_ID=

# ---- CORS（前端公网来源，逗号分隔）----
NEXUS_CORS_ORIGINS=http://EIP:3000
