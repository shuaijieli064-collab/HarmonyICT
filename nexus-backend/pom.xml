<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.nexus</groupId>
    <artifactId>nexus-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>nexus-backend</name>
    <description>NEXUS 个人世界模型后端服务（成员 A：后端与云架构）</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
        <jjwt.version>0.12.6</jjwt.version>
        <pdfbox.version>2.0.31</pdfbox.version>
        <!-- 覆盖 Boot 3.3.5 自带的 byte-buddy 1.14.x：JDK 25（class 版本 69）下 Mockito inline mock 报
             "Could not modify all classes"，6 个测试失败；1.18.x 起支持 Java 25 -->
        <byte-buddy.version>1.18.11</byte-buddy.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Apache PDFBox 2.x：PDF 逐页渲染为图片供 B 的 OCR 链路使用（阶段二遗留 PDF 转图支持；
             依赖管理归 A；B 侧为反射加载，按 2.0.31 API 编写（PDDocument.load + PDFRenderer），
             渲染 ≤20 页（MAX_PAGES=20 超限截断）、200 DPI。版本对齐拍板 2026-11-22：B 的反射调用按 2.x 签名，A 侧依赖从 3.0.5 降对齐；
             DPI 拍板 2026-11-22：保持 B 实现 200 DPI（OCR 清晰度优先，单页 PNG 约 1-3MB 在华为 OCR 体积限制内），注释原 150 系笔误已对齐实现 -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>

        <!-- 本地开发用 H2 内存库（PostgreSQL 兼容模式），生产切换华为云 RDS PostgreSQL -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 数据库版本迁移：生产用 Flyway 管理 PostgreSQL DDL；版本由 Spring Boot 3.3.5 parent 统一管理。
             local/H2 测试环境通过 application.yml 的 spring.flyway.enabled=false 关闭，仍走 schema.sql -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- 华为云 OBS SDK：默认 local 存储实现不实例化，仅 nexus.storage.type=obs 时激活 -->
        <dependency>
            <groupId>com.huaweicloud</groupId>
            <artifactId>esdk-obs-java</artifactId>
            <version>3.26.9</version>
        </dependency>

        <!-- JWT：API/impl 分离，实现与 Jackson 序列化运行时引入 -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Windows/JDK 25 下 stdout.encoding 跟随 native.encoding(GBK)，
                         只设 file.encoding 不够：日志仍会乱码，需显式覆盖 stdout/stderr。
                         disableClassPathURLCheck：Boot Manifest-JAR 含绝对路径，缺此项
                         fork 阶段报 "different root"（见 surefire dump 提示）。
                         注意：本环境 mvn 不展开 @{argLine} 占位符，故显式列出全部所需参数。 -->
                    <argLine>-Djdk.net.URLClassPath.disableClassPathURLCheck=true -Dfile.encoding=UTF-8 -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
